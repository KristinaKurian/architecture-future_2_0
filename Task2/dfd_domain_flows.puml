
@startuml
left to right direction

title Будущее 2.0 — DFD L1: потоки данных четырёх бизнес-доменов

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowFontSize 10
skinparam packageFontStyle bold
skinparam rectangleRoundCorner 8

actor "E1\nВрач клиники" as E1
actor "E2\nРуководитель / аналитик" as E2
rectangle "E3\nLegacy DWH / ESB\n(переходный источник через адаптер)" as E3 #F5F5F5

package "Домен 1. Клинические сервисы" as CLINIC #EAF4FF {
  rectangle "P1\nКлиническая система\n(операции и медицинские API)" as P1
  database "D1\nМедицинская БД\n(карты, история, исследования)" as D1
  rectangle "P2\nПубликатор бизнес-KPI\n(немедицинские агрегаты)" as P2
}

package "Домен 2. Медицинский ИИ" as MEDAI #EDEBFF {
  rectangle "P3\nСервисы медицинского ИИ\n(диагностический анализ)" as P3
}

package "Домен 3. Банковские сервисы" as BANK #E8F6ED {
  rectangle "P4\nСервис счетов и платежей" as P4
  database "D2\nБД счетов и операций" as D2
  rectangle "P5\nКредитный сервис" as P5
  database "D3\nБД кредитов" as D3
  rectangle "P6\nПубликатор банковских данных\n(разрешённые data products)" as P6
}

package "Домен 4. Корпоративное управление" as HQ #FFF1E6 {
  rectangle "P7\nКорпоративные сервисы\n(ERP / HR / закупки / финансы)" as P7
  database "D4\nБД корпоративных данных" as D4
}

package "Общая платформа данных — НЕ бизнес-домен" as PLATFORM #F1F3F6 {
  rectangle "P8\nЗагрузка / ingestion\n(API / Events / CDC / Batch)" as P8
  rectangle "P9\nПроверки качества\nи трансформации" as P9
  database "D5\nLakehouse\n(Bronze / Silver / Gold)" as D5
  rectangle "P10\nКаталог и контракты\n(метаданные / lineage)" as P10
  rectangle "P11\nSQL + семантический слой\n(разрешённые KPI)" as P11
  rectangle "P12\nПортал самообслуживания\nи BI" as P12
  rectangle "P13\nIAM / аудит\n(SSO / RBAC / ABAC)" as P13
}

' Клинические операции
E1 --> P1 : Запросы врача
P1 --> D1 : Запись меддокументов
D1 --> P1 : Медкарта / история
P1 --> P3 : Минимальный медконтекст\nзащищённый API
P3 --> P1 : Результат анализа
P1 --> P2 : Разрешённые\nучётные бизнес-показатели

' Банковские операции
P4 --> D2 : Запись операций
D2 --> P4 : Данные счетов
P5 --> D3 : Запись кредитов
D3 --> P5 : Данные кредитов
P4 --> P6 : Допустимые показатели\nсчетов и платежей
P5 --> P6 : Допустимые показатели\nкредитов

' Корпоративное управление
P7 --> D4 : Корпоративный учёт
D4 --> P7 : Данные закупок / ресурсов

' Передача разрешённых данных в аналитику
P2 --> P8 : Агрегаты клиник\nБЕЗ медицинских сведений
P6 --> P8 : Банковские data products\nпо контракту
P7 --> P8 : Корпоративные KPI\nпо контракту
E3 --> P8 : Разрешённая история\nчерез адаптер миграции

' Аналитическая обработка
P10 --> P8 : Версии контрактов,\nклассификация, правила приёма
P8 --> P9 : Проверенные входные наборы
P9 --> D5 : Очищенные наборы и витрины
P9 --> P10 : Метаданные / lineage / качество

' Самообслуживание и отчётность
E2 --> P12 : Выбор отчёта и показателей
P12 --> P10 : Поиск разрешённых наборов
P10 --> P12 : Метаданные каталога
P12 --> P11 : Запрос KPI / срезов
P11 --> D5 : SQL-запросы к витринам
D5 --> P11 : Данные витрин
P11 --> P12 : Результат отчёта

' Контроль доступа
P12 --> P13 : SSO / проверка прав / аудит
P11 --> P13 : Проверка доступа к данным

@enduml
