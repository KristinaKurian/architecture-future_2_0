
@startuml
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()

title Будущее 2.0 — целевая архитектура через год (C4 Container)

Person(business, "Бизнес-пользователь", "Аналитик или руководитель")
Person(operator, "Врач / оператор клиники", "Работа с пациентами")

System_Boundary(future, "Будущее 2.0") {

  Container_Boundary(clinic_domain, "Домен: Клинические сервисы") {
    Container(clinic_app, "Клиническая система", "Web / API", "Медицинские операции и процессы")
    ContainerDb(med_db, "Медицинская БД", "OLTP + File Storage", "Карты, истории болезни, исследования")
    Container(clinic_kpi, "Публикатор бизнес-показателей", "API / Batch", "Только разрешённые агрегаты без медицинских сведений")
  }

  Container_Boundary(ai_domain, "Домен: Медицинский ИИ") {
    Container(ai, "Сервисы медицинского ИИ", "Python", "Диагностические модели и обработка медицинских данных")
  }

  Container_Boundary(bank_domain, "Домен: Банковские сервисы") {
    Container(accounts, "Сервис счетов и платежей", "Go / Java", "Счета, операции и платежи")
    ContainerDb(accounts_db, "БД счетов и операций", "OLTP", "Данные счетов и платежей")

    Container(loans, "Кредитный сервис", "Go / Java", "Кредитные продукты и обслуживание кредитов")
    ContainerDb(loans_db, "БД кредитов", "OLTP", "Кредитные договоры и обязательства")

    Container(bank_data, "Публикатор банковских данных", "API / Events / Batch", "Разрешённые аналитические наборы и контроль состава данных")
  }

  Container_Boundary(hq_domain, "Домен: Корпоративное управление") {
    Container(hq, "Сервисы корпоративного управления", "API / ERP / HR", "Управление персоналом, закупками, ресурсами и корпоративными финансами")
    ContainerDb(hq_db, "БД корпоративных данных", "OLTP", "Персонал, закупки, инвентаризация и корпоративные финансы")
  }

  Container_Boundary(data_platform, "Общая платформа данных") {
    Container(ingest, "Загрузка данных", "CDC / Kafka / API / Batch", "Приём разрешённых доменных данных")
    Container(transform, "Обработка данных", "Airflow + Spark / SQL", "Проверки качества и трансформации")
    ContainerDb(lake, "Lakehouse", "S3 + Parquet / Iceberg", "Bronze / Silver / Gold, без медицинских карт и исследований")
    Container(catalog, "Каталог данных", "OpenMetadata / DataHub", "Метаданные, владельцы, lineage")
    Container(query, "SQL и семантический слой", "Trino + Metrics API", "Единые KPI, доступ к витринам и лимиты запросов")
    Container(portal, "Портал самообслуживания", "Web / Report Builder", "Конструктор отчётов и выбор доступных данных")
    Container(bi, "BI-система", "Power BI", "Дашборды и визуализация")
    Container(iam, "IAM и аудит", "SSO / RBAC / ABAC", "Контроль доступа и журналирование")
  }

  Container_Boundary(legacy_domain, "Legacy / переходный период") {
    ContainerDb(legacy_dwh, "Legacy DWH", "SQL Server 2008", "Исторические данные и старая бизнес-логика")
    Container(legacy_esb, "Legacy ESB", "Apache Camel", "Существующие интеграции")
    Container(legacy_adapter, "Адаптер миграции", "API / Batch", "Контролируемый перенос разрешённых данных")
  }
}

' Клинические операции
Rel(operator, clinic_app, "Работает с пациентами", "HTTPS")
Rel(clinic_app, med_db, "Читает и изменяет данные")
Rel(clinic_app, ai, "Запрос диагностики", "Защищённый API")
Rel(ai, clinic_app, "Результат диагностики", "Защищённый API")
Rel(clinic_app, clinic_kpi, "Передаёт разрешённые бизнес-показатели")

' Банковские операции
Rel(accounts, accounts_db, "Операции по счетам")
Rel(loans, loans_db, "Кредитные операции")
Rel(accounts, bank_data, "Публикует разрешённые данные")
Rel(loans, bank_data, "Публикует разрешённые данные")

' Корпоративное управление
Rel(hq, hq_db, "Операционные записи")

' Передача данных в аналитику
Rel(clinic_kpi, ingest, "Немедицинские агрегаты", "API / Batch")
Rel(bank_data, ingest, "Банковские data products", "API / Events / Batch")
Rel(hq, ingest, "Корпоративные data products", "API / CDC")

' Legacy
Rel(legacy_dwh, legacy_adapter, "Исторические данные")
Rel(legacy_esb, legacy_adapter, "Переходные интеграции")
Rel(legacy_adapter, ingest, "Разрешённые данные", "Batch / API")

' Платформа данных
Rel(ingest, transform, "Передаёт данные")
Rel(transform, lake, "Записывает данные и витрины")
Rel(catalog, ingest, "Контракты и правила")
Rel(catalog, lake, "Метаданные и lineage")
Rel(query, lake, "Читает разрешённые витрины", "SQL")

' Самообслуживание
Rel(business, portal, "Создаёт отчёты", "HTTPS")
Rel(business, bi, "Просматривает дашборды", "HTTPS")
Rel(portal, catalog, "Ищет доступные данные")
Rel(portal, query, "Выполняет запросы", "API")
Rel(bi, query, "Получает показатели", "SQL / API")

' Безопасность
Rel(portal, iam, "Аутентификация и аудит")
Rel(query, iam, "Авторизация запросов")
Rel(bi, iam, "SSO")

@enduml
